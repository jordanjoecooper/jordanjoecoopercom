---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article' | 'profile';
  publishedTime?: Date;
  keywords?: string;
  image?: ImageMetadata;
}

const { title, description, type = 'website', publishedTime, keywords, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image.src, Astro.site) : new URL('/dp.jpg', Astro.site);
const structuredData = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title.replace(/ - Jordan Joe Cooper$/, ''),
      description,
      url: canonical.href,
      datePublished: publishedTime?.toISOString(),
      dateModified: publishedTime?.toISOString(),
      image: socialImage.href,
      author: { '@type': 'Person', name: 'Jordan Joe Cooper', url: 'https://jordanjoecooper.com/' },
      publisher: { '@type': 'Person', name: 'Jordan Joe Cooper' },
      mainEntityOfPage: canonical.href,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Jordan Joe Cooper',
      url: 'https://jordanjoecooper.com/',
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme');
        if (theme === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch {}
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Jordan Joe Cooper" />
    {keywords && <meta name="keywords" content={keywords} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Jordan Joe Cooper" href="/feed.xml" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </head>
  <body class:list={{ 'home-page-body': Astro.url.pathname === '/' }}>
    <SiteHeader priority={Astro.url.pathname === '/'} />
    <slot />
    <SiteFooter />
  </body>
</html>
