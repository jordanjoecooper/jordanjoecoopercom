---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="Writing - Jordan Joe Cooper" description="Writing by Jordan Joe Cooper. Ideas about technology, leadership, and building things.">
  <main class="writing-page">
    <section class="page-intro" aria-labelledby="writing-title">
      <p class="page-kicker"><span>#</span> Essays &amp; notes</p>
      <h1 id="writing-title">Writing</h1>
      <p>Ideas, thoughts, notes, and things I learn every day.</p>
    </section>
    <ul class="writing-index">
      {posts.map((post) => (
        <li>
          <a href={`/posts/${post.id.replace(/\.md$/, '')}/`}>
            <div>
              <h2>{post.data.title}</h2>
              {post.data.description && <p>{post.data.description}</p>}
            </div>
            <time datetime={post.data.pubDate.toISOString().slice(0, 10)}>{post.data.pubDate.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' })}</time>
          </a>
        </li>
      ))}
    </ul>
  </main>
</BaseLayout>
